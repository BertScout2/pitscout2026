<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pitscout2026.AboutPage"
             Title="About">
    <VerticalStackLayout>

        <Label 
            Text="This is a program for scouting in the pits during robotics events."
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="{OnPlatform WinUI=Small, Android=Medium}"
            />

        <Label
            Text="Version 2026.03.10"
            HorizontalOptions="Center"
            FontSize="{OnPlatform WinUI=Small, Android=Medium}"
            />

        <Label
            Text="Written by Evan, Ian, and Scott"
            HorizontalOptions="Center"
            FontSize="{OnPlatform WinUI=Small, Android=Medium}"
            />

    </VerticalStackLayout>
</ContentPage>