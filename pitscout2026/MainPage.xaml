<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:pitscout2026"
    x:Class="pitscout2026.MainPage"
    x:DataType="ContentPage"
    >

    <ScrollView>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VerticalStackLayout
                Margin="10,0,0,0"
                Grid.Row="0"
                >
                <HorizontalStackLayout>
                    <Label
                        Text="Team #:"
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Entry
                        x:Name="Team_Num_Entry"
                        Text=""
                        WidthRequest="75"
                        MaxLength="5"
                        Keyboard="Numeric"
                        TextChanged="Team_Num_TextChanged"
                        Placeholder="..."
                        />
                    <Button
                        x:Name="Load_But"
                        Text="Load"
                        Clicked="Load_But_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        IsEnabled="true"
                        IsVisible="true"
                        />
                    <Button
                        x:Name="Save_But"
                        Text="Save"
                        Clicked="Save_But_Clicked"
                        BackgroundColor="Gray"
                        IsEnabled="false"
                        IsVisible="false"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="PitScoutLayout"
                Grid.Row="1"
                IsVisible="false"
                Margin="10,0,0,0"
                >
                <HorizontalStackLayout>
                    <Label
                        Text="What Is Your Drive Train?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Drive_Train_Swerve"
                        Text="Swerve"
                        Clicked="Drive_Train_Swerve_Clicked"
                        BackgroundColor="Gray"
                       />
                    <Button
                        x:Name="Drive_Train_Tank"
                        Text="Tank"
                        Clicked="Drive_Train_Tank_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                       />
                    <Entry
                        x:Name="Drive_Train_Other"
                        Text=""
                        WidthRequest="180"
                        MaxLength="100"
                        TextChanged="Drive_Train_Other_TextChanged"
                        Placeholder="Other..."
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Preferred Placement on the Field?"  
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Start_Left"
                        Text="Left"
                        Clicked="Start_Left_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Start_Middle"
                        Text="Middle"
                        Clicked="Start_Middle_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                    <Button
                        x:Name="Start_Right"
                        Text="Right"
                        Clicked="Start_Right_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Can You Climb in Auto?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Auto_Climb_No"
                        Text="No"
                        Clicked="Auto_Climb_No_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Auto_Climb_Yes"
                        Text="Yes"
                        Clicked="Auto_Climb_Yes_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Can You Shoot in Auto?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Auto_Shoot_No"
                        Text="No"
                        Clicked="Auto_Shoot_No_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Auto_Shoot_Yes"
                        Text="Yes"
                        Clicked="Auto_Shoot_Yes_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="How many cycles in auto?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Entry
                        x:Name="Auto_Cycles"
                        Text=""
                        WidthRequest="50"
                        MaxLength="3"
                        Keyboard="Numeric"
                        TextChanged="Auto_Cycles_TextChanged"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="What's Your Best Auto?"
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Entry
                        x:Name="Best_Auto"
                        Text=""
                        Placeholder="Tap Here to Start Writing..."
                        WidthRequest="330"
                        MaxLength="100"
                        TextChanged="Best_Auto_TextChanged"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Max Fuel Capacity?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Entry
                        x:Name="Max_Fuel"
                        Text=""
                        WidthRequest="50"
                        MaxLength="3"
                        Keyboard="Numeric"
                        TextChanged="Max_Fuel_TextChanged"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Can You Climb?"   
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Can_Climb_No"
                        Text="No"
                        Clicked="Can_Climb_No_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Can_Climb_Yes"
                        Text="Yes"
                        Clicked="Can_Climb_Yes_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="What Level?"   
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Climb_Level_None"
                        Text="None"
                        Clicked="Climb_Level_None_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Climb_Level_1"
                        Text="1"
                        Clicked="Climb_Level_1_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                    <Button
                        x:Name="Climb_Level_2"
                        Text="2"
                        Clicked="Climb_Level_2_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                    <Button
                        x:Name="Climb_Level_3"
                        Text="3"
                        Clicked="Climb_Level_3_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Middle or Side Climb?"  
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Climb_Loc_Middle"
                        Text="Middle"
                        Clicked="Climb_Loc_Middle_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Climb_Loc_Side"
                        Text="Side"
                        Clicked="Climb_Loc_Side_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Willing to play defense?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Play_Defense_No"
                        Text="No"
                        Clicked="Play_Defense_No_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Play_Defense_Yes"
                        Text="Yes"
                        Clicked="Play_Defense_Yes_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                <Label
                        Text="Willing to feed?" 
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                <Button
                        x:Name="Will_Feed_No"
                        Text="No"
                        Clicked="Will_Feed_No_Clicked"
                        BackgroundColor="Gray"
                        />
                <Button
                        x:Name="Will_Feed_Yes"
                        Text="Yes"
                        Clicked="Will_Feed_Yes_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                <Label
                        Text="What Are Your Strengths?"
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                <Entry
                        x:Name="Strengths"
                        Text=""
                        WidthRequest="330"
                        MaxLength="100"
                        Placeholder="Tap Here to Start Writing..."
                        TextChanged="Strengths_TextChanged"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="What's Your Fuel/Points Per Second?"   
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Entry
                        x:Name="Fps"
                        Text=""
                        WidthRequest="50"
                        MaxLength="3"
                        Keyboard="Numeric"
                        TextChanged="Fps_TextChanged"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Preferred Travel Route?"   
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Travel_Route_Over"
                        Text="Over"
                        Clicked="Travel_Route_Over_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Travel_Route_Under"
                        Text="Under"
                        Clicked="Travel_Route_Under_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label
                        Text="Human Player Accuracy?"
                        WidthRequest="250"
                        Padding="0,10,0,0"
                        />
                    <Button
                        x:Name="Human_Acc_Low"
                        Text="Low"
                        Clicked="Human_Acc_Low_Clicked"
                        BackgroundColor="Gray"
                        />
                    <Button
                        x:Name="Human_Acc_Med"
                        Text="Medium"
                        Clicked="Human_Acc_Med_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                    <Button
                        x:Name="Human_Acc_High"
                        Text="High"
                        Clicked="Human_Acc_High_Clicked"
                        BackgroundColor="Gray"
                        Margin="10,0,0,0"
                        />
                </HorizontalStackLayout>

                <Grid
                    HorizontalOptions="Fill"
                    Margin="0,0,0,160"
                    >
                    <Editor
                        x:Name="Comments"
                        Grid.Row="0"
                        Placeholder="Put in Comments..."
                        HorizontalOptions="Fill"
                        MaxLength="250"
                        HeightRequest="150"
                        Margin="0,5,10,10"
                        Text=""
                        IsEnabled="True"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        TextChanged="Comments_TextChanged"
                        />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
