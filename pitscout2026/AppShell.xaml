<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:DataType="Shell"
    x:Class="pitscout2026.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:pitscout2026"
    Shell.FlyoutBehavior="Flyout"
    Title="Pit Scout 2026">

    <FlyoutItem Title="Pit Scouting">
        <Tab>
            <ShellContent
                Title="Pit Scouting"
                ContentTemplate="{DataTemplate local:MainPage}"
                />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Airtable">
        <Tab>

            <ShellContent
             Title="Airtable"
             ContentTemplate="{DataTemplate local:AirtablePage}"
             />
        </Tab>

    </FlyoutItem>

    <FlyoutItem Title="About">
        <Tab>

            <ShellContent
                Title="About"
                ContentTemplate="{DataTemplate local:AboutPage}"
                />
        </Tab>
        
    </FlyoutItem>
</Shell>
